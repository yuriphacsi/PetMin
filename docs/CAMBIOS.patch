+        gl.glPushMatrix(); gl.glTranslatef(0f,1.1f,.55f)
+        if(mode == "eat") gl.glRotatef(22f + (sin(phase)*12).toFloat(),1f,0f,0f)
+        box(gl,0f,0f,0f,.38f,.34f,.32f,r,g,b)
+        for(x in listOf(-.26f,.26f)) {
